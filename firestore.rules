rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype rules. Use a separate Firebase project for this presentation.
    // Anonymous users must sign in; session IDs are unguessable, but these rules
    // are not appropriate for a production security-sensitive application.
    match /cameraSessions/{sessionId} {
      allow read, write: if request.auth != null;
      match /{candidateCollection}/{candidateId} {
        allow read, write: if request.auth != null &&
          (candidateCollection == 'cameraCandidates' || candidateCollection == 'viewerCandidates');
      }
    }
  }
}
